    {
      "parameters": {
        "jsCode": "// Closed category list. name_uk is what the run report prints.\nreturn [\n  ['browsers', 'Браузери', 'Веб-браузери та їх служби оновлення'],\n  ['development', 'Розробка', 'IDE, редактори коду, мови програмування, SDK, VCS, термінали'],\n  ['databases', 'Бази даних', 'СУБД, драйвери та клієнти БД'],\n  ['games', 'Ігри', 'Окремі ігри'],\n  ['game_platforms', 'Ігрові платформи', 'Лаунчери і магазини ігор, ігрові оверлеї, Xbox-сервіси'],\n  ['multimedia', 'Мультимедіа', 'Відео, аудіо, фото, запис і стрімінг, медіаплеєри'],\n  ['office', 'Офіс і продуктивність', 'Офісні пакети, нотатки, задачі, AI-асистенти, автоматизація'],\n  ['communication', 'Комунікації', \"Месенджери, відеозв'язок, пошта\"],\n  ['network_vpn', 'Мережа / VPN', 'VPN, торент-клієнти, мережеві утиліти, віддалений доступ'],\n  ['drivers_hardware', 'Драйвери та утиліти заліза', 'Драйвери, панелі керування GPU/периферії, моніторинг і розгін'],\n  ['system_runtime', 'Системні компоненти / runtime', 'Runtime-бібліотеки, фреймворки, системні компоненти ОС, пакетні менеджери'],\n  ['codecs_extensions', 'Кодеки й розширення', 'Кодеки відео/зображень, мовні пакети, розширення ОС'],\n  ['utilities', 'Утиліти', 'Архіватори, скриншоти, калькулятор, блокнот та інші прості інструменти'],\n  ['security', 'Безпека', 'Антивіруси, захист системи, менеджери паролів'],\n  ['cloud_sync', 'Хмара / синхронізація', 'Хмарні сховища, синхронізація з телефоном і пристроями'],\n  ['other', 'Інше', 'Не вдалося однозначно визначити категорію'],\n].map(([code, name_uk, description]) => ({ json: { code, name_uk, description } }));\n"
      },
