    {
      "parameters": {
        "jsCode": "// aliases: id:<package_id prefix> or name:<name prefix>, separated by |, lowercase\nreturn [\n  ['microsoft-visual-c-redistributable', 'Microsoft Visual C++ Redistributable', 'system_runtime',\n    'id:microsoft.vcredist|name:microsoft visual c++ 20|name:microsoft visual c++ v14'],\n  ['microsoft-vclibs', 'Microsoft Visual C++ UWP Runtime (VCLibs)', 'system_runtime',\n    'id:microsoft.vclibs|name:microsoft visual c++ 2015 uwp'],\n  ['windows-app-sdk-runtime', 'Windows App SDK Runtime', 'system_runtime',\n    'id:microsoft.windowsappruntime|id:msix\\\\microsoftcorporationii.winappruntime|name:windowsappruntime|name:winappruntime'],\n  ['microsoft-ui-xaml', 'Microsoft UI XAML', 'system_runtime', 'id:microsoft.ui.xaml|name:microsoft.ui.xaml'],\n  ['microsoft-net-native', 'Microsoft .NET Native', 'system_runtime',\n    'id:microsoft.dotnet.native|id:msix\\\\microsoft.net.native|name:microsoft .net native'],\n  ['microsoft-net-desktop-runtime', 'Microsoft .NET Desktop Runtime', 'system_runtime',\n    'id:microsoft.dotnet.desktopruntime|name:microsoft windows desktop runtime'],\n].map(([software_key, name, category_code, aliases]) => ({ json: {\n  software_key, name, vendor: 'Microsoft', category_code, aliases,\n  source: 'manual', confidence: 1, locked: true, needs_review: false,\n} }));\n"
      },
